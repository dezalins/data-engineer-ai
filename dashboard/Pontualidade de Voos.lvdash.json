{
  "datasets": [
    {
      "name": "obt_voos",
      "displayName": "Pontualidade de Voos (obt_voos)",
      "config": {
        "source": "voebem.gold.obt_voos",
        "measures": [
          {
            "name": "total_voos",
            "expr": "COUNT(1)",
            "displayName": "Total de Voos",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "voos_realizados",
            "expr": "SUM(CASE WHEN voo_realizado THEN 1 ELSE 0 END)",
            "displayName": "Voos Realizados",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "voos_cancelados",
            "expr": "SUM(CASE WHEN voo_cancelado THEN 1 ELSE 0 END)",
            "displayName": "Voos Cancelados",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "voos_no_prazo_partida",
            "expr": "SUM(CASE WHEN partida_pontual THEN 1 ELSE 0 END)",
            "displayName": "Voos no Prazo (Partida)"
          },
          {
            "name": "voos_no_prazo_chegada",
            "expr": "SUM(CASE WHEN chegada_pontual THEN 1 ELSE 0 END)",
            "displayName": "Voos no Prazo (Chegada)"
          },
          {
            "name": "voos_avaliaveis_partida",
            "expr": "COUNT(partida_pontual)",
            "displayName": "Voos Avaliáveis (Partida)"
          },
          {
            "name": "voos_avaliaveis_chegada",
            "expr": "COUNT(chegada_pontual)",
            "displayName": "Voos Avaliáveis (Chegada)"
          },
          {
            "name": "voos_atrasados_partida",
            "expr": "SUM(CASE WHEN NOT partida_pontual THEN 1 ELSE 0 END)",
            "displayName": "Voos Atrasados (Partida)"
          },
          {
            "name": "voos_atrasados_chegada",
            "expr": "SUM(CASE WHEN NOT chegada_pontual THEN 1 ELSE 0 END)",
            "displayName": "Voos Atrasados (Chegada)"
          },
          {
            "name": "pct_no_prazo_partida",
            "expr": "try_divide(MEASURE(`voos_no_prazo_partida`), MEASURE(`voos_avaliaveis_partida`))",
            "displayName": "% no Prazo (Partida)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_no_prazo_chegada",
            "expr": "try_divide(MEASURE(`voos_no_prazo_chegada`), MEASURE(`voos_avaliaveis_chegada`))",
            "displayName": "% no Prazo (Chegada)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "taxa_cancelamento",
            "expr": "try_divide(MEASURE(`voos_cancelados`), MEASURE(`total_voos`))",
            "displayName": "Taxa de Cancelamento",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atraso_medio_partida",
            "expr": "AVG(atraso_partida_min)",
            "displayName": "Atraso Médio Partida (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atraso_medio_chegada",
            "expr": "AVG(atraso_chegada_min)",
            "displayName": "Atraso Médio Chegada (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "minutos_recuperados_medio",
            "expr": "AVG(minutos_recuperados)",
            "displayName": "Minutos Recuperados (média)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Métricas de pontualidade e atraso de voos para análise de oportunidades de melhoria",
        "dimensions": [
          {
            "name": "nome_companhia",
            "expr": "nome_companhia",
            "displayName": "Companhia Aérea"
          },
          {
            "name": "nome_aeroporto_origem",
            "expr": "nome_aeroporto_origem",
            "displayName": "Aeroporto de Origem"
          },
          {
            "name": "nome_aeroporto_destino",
            "expr": "nome_aeroporto_destino",
            "displayName": "Aeroporto de Destino"
          },
          {
            "name": "rota_municipios",
            "expr": "rota_municipios",
            "displayName": "Rota"
          },
          {
            "name": "escopo_voo",
            "expr": "escopo_voo",
            "displayName": "Escopo do Voo"
          },
          {
            "name": "dia_semana",
            "expr": "dia_semana",
            "displayName": "Dia da Semana"
          },
          {
            "name": "hora_partida_prevista",
            "expr": "hora_partida_prevista",
            "displayName": "Hora de Partida"
          },
          {
            "name": "partida_prevista_data",
            "expr": "partida_prevista_data",
            "displayName": "Data de Partida"
          },
          {
            "name": "mes_referencia",
            "expr": "mes_referencia",
            "displayName": "Mês de Referência"
          },
          {
            "name": "uf_origem",
            "expr": "uf_origem",
            "displayName": "UF Origem"
          },
          {
            "name": "uf_destino",
            "expr": "uf_destino",
            "displayName": "UF Destino"
          },
          {
            "name": "descricao_tipo_linha",
            "expr": "descricao_tipo_linha",
            "displayName": "Tipo de Linha"
          },
          {
            "name": "situacao_voo",
            "expr": "situacao_voo",
            "displayName": "Situação do Voo"
          },
          {
            "name": "faixa_atraso_partida",
            "expr": "CASE\n  WHEN atraso_partida_min IS NULL THEN 'Sem avaliação'\n  WHEN atraso_partida_min <= 15 THEN 'No prazo (≤15 min)'\n  WHEN atraso_partida_min <= 30 THEN 'Atraso 16-30 min'\n  WHEN atraso_partida_min <= 60 THEN 'Atraso 31-60 min'\n  WHEN atraso_partida_min <= 120 THEN 'Atraso 61-120 min'\n  ELSE 'Atraso >120 min'\nEND",
            "displayName": "Faixa de Atraso (Partida)"
          },
          {
            "name": "faixa_atraso_chegada",
            "expr": "CASE\n  WHEN atraso_chegada_min IS NULL THEN 'Sem avaliação'\n  WHEN atraso_chegada_min <= 15 THEN 'No prazo (≤15 min)'\n  WHEN atraso_chegada_min <= 30 THEN 'Atraso 16-30 min'\n  WHEN atraso_chegada_min <= 60 THEN 'Atraso 31-60 min'\n  WHEN atraso_chegada_min <= 120 THEN 'Atraso 61-120 min'\n  ELSE 'Atraso >120 min'\nEND",
            "displayName": "Faixa de Atraso (Chegada)"
          }
        ]
      }
    }
  ],
